\@writefile{lof}{\contentsline {figure}{\numberline {15}{\ignorespaces Empty-state probabilities $\pi _0$ and $\pi (0,0)$ as the mechanism parameter increases from $0$ to $2.5$. \textit  {Left}: B$_2^1$ (blue) maintains $\pi _0=1-\rho $ exactly for all $\gamma _1$ — jockeying conserves total customers. C$_2^1$ (orange) shows $\pi _0$ increasing with $\theta _1$: abandonment clears the priority queue faster, raising the server's idle fraction. \textit  {Right}: same story for $\pi (0,0)$. Solid orange = closed-form formula~\eqref  {eq:C21:pi0_pi00}; dashed orange = CTMC. The two are indistinguishable (max error $<10^{-4}$). }}{61}{figure.15}\protected@file@percent }
\newlabel{fig:val_experiment_pi}{{15}{61}{Empty-state probabilities $\pi _0$ and $\pi (0,0)$ as the mechanism parameter increases from $0$ to $2.5$. \textit {Left}: B$_2^1$ (blue) maintains $\pi _0=1-\rho $ exactly for all $\gamma _1$ — jockeying conserves total customers. C$_2^1$ (orange) shows $\pi _0$ increasing with $\theta _1$: abandonment clears the priority queue faster, raising the server's idle fraction. \textit {Right}: same story for $\pi (0,0)$. Solid orange = closed-form formula~\eqref {eq:C21:pi0_pi00}; dashed orange = CTMC. The two are indistinguishable (max error $<10^{-4}$)}{figure.15}{}}
