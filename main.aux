\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces Lemma validation. \textit  {Left}: max relative residual of the fundamental PGF equation (Lemma~\ref {lem:gen:fundamental_equation}) for each model variant on a $5\times 5$ interior grid. \textit  {Right}: max relative residual of the PPGF dynamics recurrence (Lemma~\ref {lem:gen:PPGF_dynamics}) over $n\in \{1,\ldots  ,15\}$ and $y\in [0.05,0.90]$. All values lie well below the $10^{-6}$ tolerance (red dashed line).}}{57}{figure.8}\protected@file@percent }
