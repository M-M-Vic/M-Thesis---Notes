\newlabel{fig:val_corollaries}{{12}{59}{Corollaries A (blue) and C$_2$ (red): formula vs CTMC for $\pi _0$ (left column) and $\pi (0,0)$ (right column) over 60 random configurations each. Perfect agreement lies on the diagonal}{figure.12}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {13}{\ignorespaces Max relative error $\varepsilon _\infty $ of the approximate PPGF $\setbox \z@ \hbox {\mathsurround \z@ $\textstyle P$}\mathaccent "0365{P}_{\rm  app}(y,n)=(1-\rho )\rho [\setbox \z@ \hbox {\mathsurround \z@ $\textstyle y$}\mathaccent "0365{y}^*(y)]^n$ as a function of $(\rho _1,\rho _2)$. Green: accurate ($\varepsilon _\infty < 3\%$); red: poor. The approximation is reliable only when the priority class carries most of the offered load ($\rho _1/\rho \gtrsim 0.6$) and the system is not heavily loaded ($\rho \lesssim 0.6$).}}{60}{figure.13}\protected@file@percent }
\newlabel{fig:val_ppgf}{{13}{60}{Max relative error $\varepsilon _\infty $ of the approximate PPGF $\widetilde {P}_{\rm app}(y,n)=(1-\rho )\rho [\widetilde {y}^*(y)]^n$ as a function of $(\rho _1,\rho _2)$. Green: accurate ($\varepsilon _\infty < 3\%$); red: poor. The approximation is reliable only when the priority class carries most of the offered load ($\rho _1/\rho \gtrsim 0.6$) and the system is not heavily loaded ($\rho \lesssim 0.6$)}{figure.13}{}}
