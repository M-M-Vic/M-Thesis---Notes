{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/content/**",
              "components/math/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Spectral|IBM Plex Sans|IBM Plex Mono))/i]",
        "message": "Font not provided by the design system. Available: Spectral, IBM Plex Sans, IBM Plex Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='BirthDeathChain'] > JSXAttribute > JSXIdentifier[name!=/^(?:mode|lambda|mu|theta|count|width|className|style|key|ref|className|style|children)$/]",
        "message": "<BirthDeathChain> doesn't accept that prop. Declared props: mode, lambda, mu, theta, count, width, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='BirthDeathChain'] > JSXAttribute[name.name='mode'] > Literal[value!=/^(?:mm1|mm1m)$/]",
        "message": "<BirthDeathChain> mode must be one of 'mm1' | 'mm1m'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Chip'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|tone|className|style|key|ref|className|style|children)$/]",
        "message": "<Chip> doesn't accept that prop. Declared props: children, tone, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Chip'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:neutral|param|class1|class2|jockey|abandon)$/]",
        "message": "<Chip> tone must be one of 'neutral' | 'param' | 'class1' | 'class2' | 'jockey' | 'abandon'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Equation'] > JSXAttribute > JSXIdentifier[name!=/^(?:tex|display|number|align|size|className|style|key|ref|className|style|children)$/]",
        "message": "<Equation> doesn't accept that prop. Declared props: tex, display, number, align, size, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Equation'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:left|center|right)$/]",
        "message": "<Equation> align must be one of 'left' | 'center' | 'right'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Equation'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Equation> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Figure'] > JSXAttribute > JSXIdentifier[name!=/^(?:src|alt|number|caption|source|frame|className|style|key|ref|className|style|children)$/]",
        "message": "<Figure> doesn't accept that prop. Declared props: src, alt, number, caption, source, frame, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='FlowDiagram'] > JSXAttribute > JSXIdentifier[name!=/^(?:space|gamma1|gamma2|theta1|theta2|gamma1Label|gamma2Label|theta1Label|theta2Label|width|className|style|key|ref|className|style|children)$/]",
        "message": "<FlowDiagram> doesn't accept that prop. Declared props: space, gamma1, gamma2, theta1, theta2, gamma1Label, gamma2Label, theta1Label, theta2Label, width, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='FlowDiagram'] > JSXAttribute[name.name='space'] > Literal[value!=/^(?:S|Stilde)$/]",
        "message": "<FlowDiagram> space must be one of 'S' | 'Stilde'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ModelBadge'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|status|mechanism|active|size|className|style|key|ref|className|style|children)$/]",
        "message": "<ModelBadge> doesn't accept that prop. Declared props: name, status, mechanism, active, size, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ModelBadge'] > JSXAttribute[name.name='status'] > Literal[value!=/^(?:solved|open|neutral)$/]",
        "message": "<ModelBadge> status must be one of 'solved' | 'open' | 'neutral'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ModelBadge'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md)$/]",
        "message": "<ModelBadge> size must be one of 'sm' | 'md'."
      },
      {
        "selector": "JSXOpeningElement[name.name='QueueDiagram'] > JSXAttribute > JSXIdentifier[name!=/^(?:lambda1|lambda2|mu|jockey|jockey2|abandon|abandon2|jockeyLabel|jockey2Label|abandonLabel|abandon2Label|width|className|style|key|ref|className|style|children)$/]",
        "message": "<QueueDiagram> doesn't accept that prop. Declared props: lambda1, lambda2, mu, jockey, jockey2, abandon, abandon2, jockeyLabel, jockey2Label, abandonLabel, abandon2Label, width, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatCallout'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|label|unit|trend|note|accent|align|className|style|key|ref|className|style|children)$/]",
        "message": "<StatCallout> doesn't accept that prop. Declared props: value, label, unit, trend, note, accent, align, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatCallout'] > JSXAttribute[name.name='trend'] > Literal[value!=/^(?:down|up|flat)$/]",
        "message": "<StatCallout> trend must be one of 'down' | 'up' | 'flat'."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatCallout'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:left|center)$/]",
        "message": "<StatCallout> align must be one of 'left' | 'center'."
      },
      {
        "selector": "JSXOpeningElement[name.name='TheoremBox'] > JSXAttribute > JSXIdentifier[name!=/^(?:kind|number|title|children|className|style|key|ref|className|style|children)$/]",
        "message": "<TheoremBox> doesn't accept that prop. Declared props: kind, number, title, children, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='TheoremBox'] > JSXAttribute[name.name='kind'] > Literal[value!=/^(?:theorem|lemma|corollary|definition|remark|claim|approximation)$/]",
        "message": "<TheoremBox> kind must be one of 'theorem' | 'lemma' | 'corollary' | 'definition' | 'remark' | 'claim' | 'approximation'."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
